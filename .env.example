# Copy to .env.local and fill in. For Gmail, SMTP_PASSWORD is a Google App Password
# (Google account > Security > 2-Step Verification > App passwords), not the login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional: defaults to true on port 465, false elsewhere (STARTTLS).
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

# Must be a mailbox the SMTP account may send as, otherwise SPF/DMARC drops the mail.
CONTACT_MAIL_FROM="Portfolio Contact <you@gmail.com>"
# Inbox that receives contact form submissions.
CONTACT_MAIL_TO=you@gmail.com

# Split.io feature flags. Leave NEXT_PUBLIC_SPLIT_IO_SDK_API_KEY empty to run the SDK in
# localhost mode, where the mocked treatments in src/providers/FeatureFlag turn every
# gated section on. Set it to evaluate the real flags.
NEXT_PUBLIC_SPLIT_IO_SDK_API_KEY=
NEXT_PUBLIC_SPLIT_IO_USER_KEY=
